# ============================================================================
# Video Driver Module Makefile
# ============================================================================

# Source files
SRCS = vbe.c fb.c font8x16.c gfxcon.c video.c fbdev.c

# Object files (in build directory)
OBJS = $(addprefix $(BUILD_DIR)/, $(SRCS:.c=.o))

# Header dependencies (generated by -MMD)
-include $(OBJS:.o=.d)

# The -include of .d files above would otherwise make the first .o the
# default goal; force it back to "all".
.DEFAULT_GOAL := all

# Build all objects
all: $(OBJS)

# Compilation rule
$(BUILD_DIR)/%.o: %.c
	@echo "  CC      driver/video/$<"
	@$(CC) $(CFLAGS) $(INCLUDE) $< -o $@

.PHONY: all

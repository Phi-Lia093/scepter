# ============================================================================
# Filesystem Module Makefile
# ============================================================================

# Subdirectories
SUBDIRS = minix3 ext2

# Source files in fs/
SRCS = vfs.c devfs.c pipe.c locks.c fifo.c procfs.c tmpfs.c

# Object files (in build directory)
OBJS = $(addprefix $(BUILD_DIR)/, $(SRCS:.c=.o))

# Header dependencies (generated by -MMD)
-include $(OBJS:.o=.d)

# The -include of .d files above would otherwise make the first .o the
# default goal; force it back to "all".
.DEFAULT_GOAL := all

# Build all objects
all: $(OBJS) subdirs

# Build subdirectories
subdirs:
	@for dir in $(SUBDIRS); do \
		$(MAKE) -C $$dir || exit 1; \
	done

# Compilation rule
$(BUILD_DIR)/%.o: %.c
	@echo "  CC      fs/$<"
	@$(CC) $(CFLAGS) $(INCLUDE) $< -o $@

.PHONY: all subdirs

# ============================================================================
# i386 Architecture Module Makefile
# Builds all arch-specific objects into the top-level build directory.
# ============================================================================

# Source files
SRCS_C = cpu.c stackframe.c irq.c pic.c lapic.c ioapic.c paging.c mem.c timer.c trap.c uaccess.c
SRCS_S = boot.s context.s isr.s

# Object files (in build directory)
OBJS = $(addprefix $(BUILD_DIR)/, $(SRCS_C:.c=.o) $(SRCS_S:.s=.o))

# Header dependencies (generated by -MMD)
-include $(OBJS:.o=.d)

# The -include of .d files above would otherwise make the first .o the
# default goal; force it back to "all".
.DEFAULT_GOAL := all

# Build all objects
all: $(OBJS)

# C source compilation
$(BUILD_DIR)/%.o: %.c
	@echo "  CC      arch/i386/$<"
	@$(CC) $(CFLAGS) $(INCLUDE) $< -o $@

# Assembly source compilation
$(BUILD_DIR)/%.o: %.s
	@echo "  AS      arch/i386/$<"
	@$(CC) $(CFLAGS) $(INCLUDE) $< -o $@

.PHONY: all
